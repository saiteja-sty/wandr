# ============================================================
# Wandr .gitignore — covers Java/Maven + frontend + IDEs
# ============================================================

# --- Maven / Java ---
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# --- Spring Boot ---
build/
out/
.gradle/
HELP.md

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr

# --- VS Code ---
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- Eclipse ---
.classpath
.project
.settings/
.factorypath

# --- Environment / Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
credentials.json

# --- Node / Frontend tooling (in case we add npm later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.cache/
dist/

# --- OS ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Logs ---
*.log
logs/

# --- Database ---
*.db
*.sqlite
*.sqlite3

# --- Coverage / Testing ---
.coverage
coverage/
htmlcov/
*.cover

# --- Misc ---
.tmp/
tmp/
*.bak
